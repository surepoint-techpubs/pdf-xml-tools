TODO.md

# Lint config/cache -- dev-machine-only
deploy/tools/ruff.toml
deploy/tools/.ruff_cache

# Old sibling app kept for reference -- bundled Windows binaries and
# PyInstaller build output, ~730MB, doesn't belong in git regardless
/old_pdf_xml/
