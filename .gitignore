# The actual database -- real user accounts, never committed.
# schema.sql is the tracked source of truth instead.
*.db
*.db.bak*
*.sqlite3

# Session-signing secret (regenerated automatically on first run)
.secret_key

# Per-session uploaded PDFs -- ephemeral, never committed
/uploads/

# Sample PDFs used for local testing -- real company documents
*.pdf
# ...except the style guide, a real shipped static asset, not a test sample
!static/style_guide.pdf

# Python
__pycache__/
*.pyc

# Virtual environment
.venv/

# Claude Code local settings
.claude/

